# Real transaction execution is deliberately opt-in.
EVM_EXECUTION_ENABLED=false

# 32 random bytes, encoded as hex (64 characters) or base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_VAULT_MASTER_KEY=

# API protection for signer management and execution-related write endpoints.
EXECUTION_API_TOKEN=

# Optional environment signer map. Prefer encrypted signers in MySQL.
# Example shape (do not commit real keys): {"0xYourAddress":"0xYourPrivateKey"}
WALLET_PRIVATE_KEYS_JSON=

# Li.Fi is used for token resolution, swaps and bridges.
LIFI_API_URL=https://li.quest/v1
LIFI_API_KEY=
LIFI_INTEGRATOR=evm-wallet-console

# The nine EVM RPC overrides remain EVM_RPC_ETHEREUM, EVM_RPC_ARBITRUM, ...
# EVM_WORKER_INTERVAL_MS=5000
# EVM_WORKER_CONCURRENCY=2
# EVM_TASK_MAX_RETRIES=3
# EVM_RECEIPT_CONFIRMATIONS=1
# EVM_RUNNING_LEASE_MS=7200000
# EVM_BRIDGE_TIMEOUT_MS=1800000
